изнаки на основе DepTime\")\n        df.drop(['DepTime'], axis=1, inplace=True)\n    \n    # День недели\n    df['IsWeekend'] = (df['DayOfWeek'] >= 6).astype(int)\n    df['IsMonday'] = (df['DayOfWeek'] == 1).astype(int)\n    df['IsFriday'] = (df['DayOfWeek'] == 5).astype(int)\n    \n    # Маршрут Origin→Dest\n    df['Route'] = df['Origin'] + '_' + df['Dest']\n    \n    # Время суток (только на основе DepHour)\n    df['TimeOfDay'] = pd.cut(df['DepHour'], \n                             bins=[0, 6, 12, 18, 24], \n                             labels=['Night', 'Morning', 'Afternoon', 'Evening'],\n                             include_lowest=True)\n    \n    return df\n\ntrain_fe = transform(train)\ntest_fe = transform(test)\n\n# Проверяем, что dep_delayed_15min есть в train\nif 'dep_delayed_15min' in train_fe.columns:\n    train_fe['target'] = (train_fe['dep_delayed_15min'] == 'Y').astype(int)\n    train_fe.drop('dep_delayed_15min', axis=1, inplace=True)\nelse:\n    print(\"Ошибка: столбец 'dep_delayed_15min' не найден!\")\n    print(\"Доступные столбцы:\", train_fe.columns.tolist())\n\nif 'dep_delayed_15min' in test_fe.columns:\n    test_fe.drop('dep_delayed_15min', axis=1, inplace=True)\n\nos.makedirs('/kaggle/working', exist_ok=True)\ntrain_fe.to_parquet('/kaggle/working/train_processed.parquet', index=False)\nprint(f'\\nСохранено: {train_fe.shape}')\nprint(f'Доля задержанных рейсов: {round(train_fe[\"target\"].mean(), 3)}')\n\n# Проверяем, что все в порядке\nprint(f'\\nКолонки в train_fe: {train_fe.columns.tolist()}')\nprint(f'Колонки в test_fe: {test_fe.columns.tolist()}')\n\n# Разделение на признаки и целевую переменную\nX = train_fe.drop('target', axis=1)\ny = train_fe['target']\n\n# Определяем категориальные и числовые признаки\n# Исключаем только те, что точно есть\ncategorical_cols = ['Origin', 'Dest', 'UniqueCarrier', 'Route', 'TimeOfDay']\nnumeric_cols = ['Month', 'DayofMonth', 'DayOfWeek', 'DepHour', 'DepMinute', \n                'IsWeekend', 'IsMonday', 'Is